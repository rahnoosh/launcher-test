<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: installs new HomeBase builds from GitHub (Android asks to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: lets the Apps row see installed TV apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Stremio and Nuvio, to open movies and shows in them. -->
        <package android:name="com.stremio.one" />
        <package android:name="com.nuvio.tv" />
        <package android:name="com.nuvio.app" />
    </queries>

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeBase"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Player bridge: pick HomeBase as TiviMate's external player. Plays the stream, keeps a
          resume point in the "Recently watched in TiviMate" row and scrobbles to Trakt.
        -->
        <activity
            android:name=".player.PlayerActivity"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="@string/player_label"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.HomeBase.Player">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Screensaver: live scores, what's on next and artwork. Switched on with adb (see README). -->
        <service
            android:name=".dream.HomeBaseDream"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Game page: box score, scoring plays, stats; F1 weekend; UFC card. -->
        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Teams screen: follow teams, fights, F1, golf, tennis. -->
        <activity
            android:name=".ui.TeamsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Gets the package installer's answer for self-updates. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Screensaver preview from Quick settings. -->
        <activity
            android:name=".dream.ScreensaverActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.HomeBase.Player" />

        <!-- Google TV ignores third-party HOME apps, so this service sends the Home button here. -->
        <service
            android:name=".service.HomeButtonService"
            android:exported="false"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
    </application>
</manifest>
